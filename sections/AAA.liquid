
{%if section.settings.TripleAAA_text %}
    {% if section.settings.show_subtitle == true %}
        <h3>this is a quick subtitle</h3>
    {% endif %}

    <h2>{{section.settings.TripleAAA_text |  escape }}</h2>
  
{% endif %}


{% render 'card-product', show_vendor: section.settings.show_vendor %}


{%  render 'add-to-cart-button' %} %}



{% schema  %}


{
    "name": "TripleAAA",
    "presets": [
        {
        "name" : "TripleAAA"
        }
    ],
    "settings" : [
        {
            "type": "text",
            "id" : "TripleAAA_text",
            "label": "TripleAAA Text"

        },
        {
            "type": "checkbox",
            "id": "show_subtitle",
            "label": "subtitle"
        }
    ]
}

{% endschema %}